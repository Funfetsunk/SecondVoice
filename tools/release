#!/usr/bin/env bash
# Build the release: story file, website and web interpreter.
# Output: Second Voice.materials/Release/
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
project="$root/Second Voice.inform"
inform="${INFORM_HOME:-/c/Program Files/Inform}"

"$root/tools/build" --release

export MSYS2_ARG_CONV_EXCL='*'
"$inform/Compilers/inblorb.exe" \
    "$(cygpath -w "$project/Release.blurb")" \
    "$(cygpath -w "$project/Build/output.gblorb")" > "$project/Build/inblorb.log" 2>&1 || {
  cat "$project/Build/inblorb.log"
  echo "tools/release: inblorb failed." >&2
  exit 1
}
tail -3 "$project/Build/inblorb.log"

# inblorb leaves these two to the IDE: the download its page links to, and the
# small cover, which it otherwise fills with the full-size image.
release="$root/Second Voice.materials/Release"
cp "$project/Build/output.gblorb" "$release/Second Voice.gblorb"
cp "$root/Second Voice.materials/Small Cover.png" "$release/Small Cover.png"

# Playtesters' feedback link, on a new tab so the game in play isn't lost.
feedback='<li><a href="https://github.com/Funfetsunk/SecondVoice/issues/new" target="_blank" rel="noopener">Send feedback</a></li>'
for page in index.html play.html; do
  sed -i "s|</ul>|$feedback</ul>|" "$release/$page"
  grep -q 'Send feedback' "$release/$page" || { echo "tools/release: no feedback link in $page." >&2; exit 1; }
done

echo "tools/release: ok. Second Voice.materials/Release/"
